+
+/* NotProton: Apple's MetalFX DLSS bridge (nvngx-on-metalfx, linked as system32 nvngx.dll)
+ * carries no NVIDIA signature, and the NGX loader inside NVIDIA Streamline refuses an
+ * unsigned NGX core, so Streamline games never offer DLSS. When the run script sets
+ * NOTPROTON_NGX_SIGNER (NVAPI=1 on D3DMetal), a signature check of that one file, by
+ * path, is answered from an NVIDIA-signed Streamline module that ships with the game. */
+static const WCHAR *notproton_ngx_signer( const WCHAR *path, WCHAR *buf, DWORD len )
+{
+    static const WCHAR * const signed_modules[] = { L"sl.interposer.dll", L"sl.common.dll", L"nvngx_dlss.dll" };
+    WCHAR sysdir[MAX_PATH];
+    const WCHAR *base;
+    WCHAR *slash;
+    DWORD i, sysdir_len;
+
+    if (!path || !GetEnvironmentVariableW( L"NOTPROTON_NGX_SIGNER", NULL, 0 )) return path;
+    base = wcsrchr( path, '\\' );
+    if (!base) return path;
+    base++;
+    if (wcsicmp( base, L"nvngx.dll" ) && wcsicmp( base, L"_nvngx.dll" )) return path;
+    /* Only the system directory's copy, not any folder that happens to be called system32. */
+    sysdir_len = GetSystemDirectoryW( sysdir, ARRAY_SIZE(sysdir) );
+    if (!sysdir_len || sysdir_len >= ARRAY_SIZE(sysdir)) return path;
+    if ((DWORD)(base - 1 - path) != sysdir_len || wcsnicmp( path, sysdir, sysdir_len )) return path;
+    if (!GetModuleFileNameW( NULL, buf, len ) || !(slash = wcsrchr( buf, '\\' ))) return path;
+    for (i = 0; i < ARRAY_SIZE(signed_modules); i++)
+    {
+        if (wcslen( signed_modules[i] ) + 1 > len - (DWORD)(slash + 1 - buf)) continue;
+        wcscpy( slash + 1, signed_modules[i] );
+        if (GetFileAttributesW( buf ) == INVALID_FILE_ATTRIBUTES) continue;
+        FIXME( "NotProton: checking the signature of %s against %s\n", debugstr_w(path), debugstr_w(buf) );
+        return buf;
+    }
+    return path;
+}
+
+/***********************************************************************
+ *		CryptQueryObject (CRYPT32.@)
+ */
+BOOL WINAPI CryptQueryObject(DWORD dwObjectType, const void *pvObject,
+ DWORD dwExpectedContentTypeFlags, DWORD dwExpectedFormatTypeFlags,
+ DWORD dwFlags, DWORD *pdwMsgAndCertEncodingType, DWORD *pdwContentType,
+ DWORD *pdwFormatType, HCERTSTORE *phCertStore, HCRYPTMSG *phMsg,
+ const void **ppvContext)
+{
+    WCHAR ngx_signer[MAX_PATH];
+
+    if (dwObjectType == CERT_QUERY_OBJECT_FILE)
+        pvObject = notproton_ngx_signer(pvObject, ngx_signer, ARRAY_SIZE(ngx_signer));
+    return crypt_query_object(dwObjectType, pvObject, dwExpectedContentTypeFlags,
+     dwExpectedFormatTypeFlags, dwFlags, pdwMsgAndCertEncodingType, pdwContentType,
+     pdwFormatType, phCertStore, phMsg, ppvContext);
 }
 
