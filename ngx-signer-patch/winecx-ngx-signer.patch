+    if ((DWORD)(base - 1 - path) != sysdir_len || wcsnicmp( path, sysdir, sysdir_len )) return path;
+    if (!GetModuleFileNameW( NULL, buf, len ) || !(slash = wcsrchr( buf, '\\' ))) return path;
+    for (i = 0; i < ARRAY_SIZE(signed_modules); i++)
+    {
+        if (wcslen( signed_modules[i] ) + 1 > len - (DWORD)(slash + 1 - buf)) continue;
+        wcscpy( slash + 1, signed_modules[i] );
+        if (GetFileAttributesW( buf ) == INVALID_FILE_ATTRIBUTES) continue;
+        FIXME( "NotProton: checking the signature of %s against %s\n", debugstr_w(path), debugstr_w(buf) );
+        return buf;
+    }
+    return path;
+}
+
+/* A redirected check runs on a copy of the caller's WINTRUST_DATA and WINTRUST_FILE_INFO,
+ * so the caller's structs are never written (they may be read-only) except hWVTStateData,
+ * the state handle WinVerifyTrust hands back. The copy is on the heap because with
+ * WTD_STATEACTION_VERIFY the provider state keeps pointing at it until the
+ * WTD_STATEACTION_CLOSE call; live copies are tracked so that call can free them. */
+struct ngx_trust_copy
+{
+    WINTRUST_DATA data;
+    WINTRUST_FILE_INFO file;
+    WCHAR path[MAX_PATH];
+};
+
+static SRWLOCK ngx_copies_lock = SRWLOCK_INIT;
+static struct ngx_trust_copy *ngx_copies[16];
+
+static BOOL ngx_copy_track( struct ngx_trust_copy *copy )
+{
+    BOOL tracked = FALSE;
+    DWORD i;
+
+    AcquireSRWLockExclusive( &ngx_copies_lock );
+    for (i = 0; i < ARRAY_SIZE(ngx_copies) && !tracked; i++)
+        if (!ngx_copies[i]) ngx_copies[i] = copy, tracked = TRUE;
+    ReleaseSRWLockExclusive( &ngx_copies_lock );
+    return tracked;
+}
+
+/* Removes and returns the tracked copy whose WINTRUST_DATA is data, or NULL. */
+static struct ngx_trust_copy *ngx_copy_untrack( const WINTRUST_DATA *data )
+{
+    struct ngx_trust_copy *found = NULL;
+    DWORD i;
+
+    if (!data) return NULL;
+    AcquireSRWLockExclusive( &ngx_copies_lock );
+    for (i = 0; i < ARRAY_SIZE(ngx_copies) && !found; i++)
+        if (ngx_copies[i] && &ngx_copies[i]->data == data) found = ngx_copies[i], ngx_copies[i] = NULL;
+    ReleaseSRWLockExclusive( &ngx_copies_lock );
+    return found;
+}
+
+/* The copy to verify instead of data, or NULL when data's file is not redirected. */
+static struct ngx_trust_copy *ngx_trust_copy( const WINTRUST_DATA *data )
+{
+    struct ngx_trust_copy *copy;
+    WCHAR signer[MAX_PATH];
+    const WCHAR *path;
+
+    if (!data || data->dwUnionChoice != WTD_CHOICE_FILE || !data->pFile || data->pFile->hFile)
+        return NULL;
+    path = notproton_ngx_signer( data->pFile->pcwszFilePath, signer, ARRAY_SIZE(signer) );
+    if (path == data->pFile->pcwszFilePath) return NULL;
+    if (!(copy = calloc( 1, sizeof(*copy) ))) return NULL;
+    memcpy( &copy->data, data, min( data->cbStruct, sizeof(copy->data) ) );
+    memcpy( &copy->file, data->pFile, min( data->pFile->cbStruct, sizeof(copy->file) ) );
+    lstrcpynW( copy->path, path, ARRAY_SIZE(copy->path) );
+    copy->file.pcwszFilePath = copy->path;
+    copy->data.pFile = &copy->file;
+    return copy;
+}
