diff --git a/dlls/winemac.drv/d3dmetal_objc.m b/dlls/winemac.drv/d3dmetal_objc.m
index 9b4a054f..37b04dfb 100644
--- a/dlls/winemac.drv/d3dmetal_objc.m
+++ b/dlls/winemac.drv/d3dmetal_objc.m
@@ -72,4 +72,104 @@ @implementation WineMetalLayer
 
 @end
 
+
+/* D3DMetal (libd3dshared's WineSwapchainCallbacks::InitializeForHWND) sizes a window's
+ * backbuffer, and through it the CAMetalLayer drawable, from -frame of the view
+ * macdrv_view_create_metal_view() returns. A frame is in points, but D3D sizes are Win32
+ * pixels, which are backing pixels in Retina mode, so the backbuffer came out at half the
+ * window's Win32 size and a game rendering for its client rect showed only the top-left
+ * quarter. D3DMetal gets this proxy instead: -frame in Win32 pixels, the same conversion
+ * every other path makes with cgrect_win_from_mac(), and everything else forwarded. */
+@interface WineD3DMetalViewProxy : NSProxy
+{
+    NSView* view;
+}
+
+    - (instancetype) initWithView:(NSView*)aView;
+    - (NSView*) wineView;
+
+@end
+
+@implementation WineD3DMetalViewProxy
+
+    - (instancetype) initWithView:(NSView*)aView
+    {
+        view = [aView retain];
+        return self;
+    }
+
+    - (void) dealloc
+    {
+        [view release];
+        [super dealloc];
+    }
+
+    - (NSView*) wineView
+    {
+        return view;
+    }
+
+    /* Read on the main thread, behind the frame updates macdrv has already queued
+     * there: ResizeBuffers runs in the game's WM_SIZE handler, right after
+     * macdrv_WindowPosChanged() queued the view's new frame. */
+    - (NSRect) frame
+    {
+        __block NSRect frame;
+
+        if ([NSThread isMainThread])
+            frame = [view frame];
+        else
+            OnMainThread(^{ frame = [view frame]; });
+        return cgrect_win_from_mac(frame);
+    }
+
+    - (id) forwardingTargetForSelector:(SEL)selector
+    {
+        return view;
+    }
+
+    - (NSMethodSignature*) methodSignatureForSelector:(SEL)selector
+    {
+        return [view methodSignatureForSelector:selector];
+    }
+
+    - (void) forwardInvocation:(NSInvocation*)invocation
+    {
+        [invocation invokeWithTarget:view];
+    }
+
+    - (BOOL) respondsToSelector:(SEL)selector
+    {
+        return [view respondsToSelector:selector];
+    }
+
+    - (BOOL) isKindOfClass:(Class)aClass
+    {
+        return [view isKindOfClass:aClass];
+    }
+
+@end
+
+macdrv_metal_view macdrv_d3dmetal_wrap_metal_view(macdrv_metal_view v)
+{
+    return (macdrv_metal_view)[[WineD3DMetalViewProxy alloc] initWithView:(NSView*)v];
+}
+
+macdrv_metal_view macdrv_d3dmetal_unwrap_metal_view(macdrv_metal_view v)
+{
+    id object = (id)v;
+
+    if (object && object_getClass(object) == [WineD3DMetalViewProxy class])
+        return (macdrv_metal_view)[(WineD3DMetalViewProxy*)object wineView];
+    return v;
+}
+
+void macdrv_d3dmetal_release_metal_view_wrapper(macdrv_metal_view v)
+{
+    id object = (id)v;
+
+    if (object && object_getClass(object) == [WineD3DMetalViewProxy class])
+        [object release];
+}
+
 #endif
