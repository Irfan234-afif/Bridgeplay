diff --git a/dlls/winemac.drv/window.c b/dlls/winemac.drv/window.c
index d31cd24d..fe575d61 100644
--- a/dlls/winemac.drv/window.c
+++ b/dlls/winemac.drv/window.c
@@ -1909,7 +1909,37 @@ void macdrv_WindowPosChanged(HWND hwnd, HWND insert_after, HWND owner_hint, UINT
     }
 
 done:
-    release_win_data(data);
+    /* CW HACK 22435: D3DMetal's client surfaces are not on win32u's list, so
+     * update_client_surfaces() skips them and their views only caught up with the
+     * window on the next present. A game that answers WM_SIZE with ResizeBuffers
+     * then had D3DMetal read the old view frame and keep the old backbuffer size
+     * (Ravenswatch: maximized 3024x1752 kept after going 3024x1964 borderless).
+     * Queue the shown surface's view frame now, before WM_SIZE. Wine 11.17 no longer
+     * exports client_surface_update(), so this goes through client_surface_present(),
+     * which updates the same way and then shows the surface; limiting it to the
+     * surface that is already the window's client view keeps that a no-op. win32u
+     * locks the surfaces before the window data, so it runs after release_win_data(). */
+    {
+        struct client_surface *shown = NULL;
+        CFIndex i, count = data->d3dmetal_client_surfaces ? CFArrayGetCount(data->d3dmetal_client_surfaces) : 0;
+
+        for (i = 0; i < count && data->client_view; i++)
+        {
+            struct macdrv_client_surface *surface =
+                (struct macdrv_client_surface *)CFArrayGetValueAtIndex(data->d3dmetal_client_surfaces, i);
+            if (surface->cocoa_view != data->client_view) continue;
+            shown = &surface->client;
+            client_surface_add_ref(shown);
+            break;
+        }
+        release_win_data(data);
+
+        if (shown)
+        {
+            client_surface_present(shown);
+            client_surface_release(shown);
+        }
+    }
 }
 
 
